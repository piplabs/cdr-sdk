{
  "name": "@piplabs/cdr-cli",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cdr-cli": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude '**/__integration__/**' --exclude '**/node_modules/**' --exclude '**/dist/**'",
    "test:integration": "pnpm clean && pnpm build && vitest run __integration__",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@piplabs/cdr-sdk": "workspace:*",
    "commander": "^14",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "execa": "^8",
    "tsx": "^4",
    "typescript": "^5.5",
    "vitest": "^2"
  }
}
