{
  "name": "@piplabs/cdr-contracts",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tshy",
    "clean": "rm -rf dist .tshy-build",
    "lint": "tsc --noEmit"
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "viem": "^2.21"
  },
  "devDependencies": {
    "tshy": "^4.1.2",
    "typescript": "^5.5",
    "viem": "^2.47.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/piplabs/cdr-sdk.git",
    "directory": "packages/contracts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
