{
  "name": "@piplabs/cdr-crypto",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tshy && node ./scripts/copy-wasm-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .tshy-build",
    "lint": "tsc --noEmit"
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "dependencies": {
    "@ethereumjs/rlp": "10.1.1",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2",
    "tshy": "^4.1.2",
    "typescript": "^5.5",
    "vitest": "^2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/piplabs/cdr-sdk.git",
    "directory": "packages/crypto"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
