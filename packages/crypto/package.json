    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ethereumjs/rlp": "10.1.1",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2",
    "typescript": "^5.5",
    "vitest": "^2"
  }
}
