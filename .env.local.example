# CDR SDK integration test config. Copy to .env.local and fill in real values.

# Story-API REST endpoint (port 1317)
CDR_API_URL=

# EVM JSON-RPC endpoint (port 8545)
CDR_RPC_URL=

# Funded test wallet private key (hex, 0x-prefixed)
CDR_TEST_PRIVATE_KEY=

# Test wallet address (derivable from CDR_TEST_PRIVATE_KEY)
CDR_TEST_ADDRESS=
